diff --git a/scripts/pitunes-kiosk-launch.sh b/scripts/pitunes-kiosk-launch.sh
index be814ab..481a75a 100755
--- a/scripts/pitunes-kiosk-launch.sh
+++ b/scripts/pitunes-kiosk-launch.sh
@@ -7,6 +7,10 @@ DISPLAY="${DISPLAY:-:0}"
 XAUTHORITY="${XAUTHORITY:-${HOME}/.Xauthority}"
 PROFILE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/pitunes-kiosk-chromium"
 CHROMIUM="$(command -v chromium-browser || command -v chromium)"
+GRAPHICS_FLAGS=(--use-angle=gles --ignore-gpu-blocklist)
+if [[ "$(uname -m)" =~ ^(x86_64|i[3-6]86)$ ]]; then
+  GRAPHICS_FLAGS=(--use-gl=angle --use-angle=swiftshader --enable-unsafe-swiftshader)
+fi

 export DISPLAY XAUTHORITY

@@ -52,8 +56,7 @@ exec "${CHROMIUM}" \
   --media-cache-size=16777216 \
   --touch-events=enabled \
-  --enable-gpu-rasterization \
-  --use-angle=gles \
-  --ignore-gpu-blocklist \
+  --disable-gpu-rasterization \
+  "${GRAPHICS_FLAGS[@]}" \
   --disable-logging \
   --background-color=0x08080f \
   --kiosk "${URL}"
diff --git a/scripts/setup-kiosk.sh b/scripts/setup-kiosk.sh
index 0181658..4caba3b 100755
--- a/scripts/setup-kiosk.sh
+++ b/scripts/setup-kiosk.sh
@@ -8,11 +8,15 @@ if [ "$(id -u)" -ne 0 ]; then
 fi

 KIOSK_USER="${KIOSK_USER:-pi}"
+KIOSK_PACKAGES=(xserver-xorg x11-xserver-utils xinit openbox chromium lightdm feh accountsservice)
+if [[ "$(dpkg --print-architecture)" =~ ^(amd64|i386)$ ]]; then
+  KIOSK_PACKAGES+=(lightdm-gtk-greeter fonts-dejavu libgl1-mesa-dri chromium-sandbox)
+fi

 echo "Installing minimal kiosk stack..."
 apt-get update
 DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
-  xserver-xorg x11-xserver-utils xinit openbox chromium lightdm feh accountsservice
+  "${KIOSK_PACKAGES[@]}"

 if ! id "${KIOSK_USER}" >/dev/null 2>&1; then
   echo "Kiosk user does not exist: ${KIOSK_USER}" >&2
